# Пример secrets-файла — переименуйте в secrets.yaml и заполните реальные значения локально
# НЕ пушьте secrets.yaml в публичные репозитории.

wifi_ssid: "ВАША_WIFI"
wifi_password: "ВАШ_WIFI_PASSWORD"
esphome_api_encryption_key: "ВАША_32_БАЙТОВАЯ_ИЛИ_ДЛИННАЯ_СТРОКА"
esphome_ota_password: "ВАШ_OTA_ПАРОЛЬ"

# entity_id медиаплеера (например: media_player.yandex_station)
alice_media_player_entity_id: "media_player.yandex_station"

# Опциональные параметры статического IP (раскомментируйте, если нужно)
# esphome_static_ip: "192.168.0.147"
# esphome_gateway: "192.168.0.1"
# esphome_subnet: "255.255.255.0"
