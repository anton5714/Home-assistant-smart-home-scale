# Copy this file to secrets.yaml and replace every value.
# NEVER commit your real secrets.yaml.

wifi_ssid: "YOUR_WIFI_NAME"
wifi_password: "YOUR_WIFI_PASSWORD"

# ESPHome API encryption key.
# Generate one with ESPHome instead of inventing a value.
esphome_api_encryption_key: "YOUR_BASE64_API_KEY"

# Strong password used for ESPHome OTA updates.
esphome_ota_password: "CHANGE_ME_TO_A_STRONG_PASSWORD"

# Optional: only needed by automations that target a specific media player.
# alice_media_player_entity_id: "media_player.yandex_station"
